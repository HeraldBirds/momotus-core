/*
  # === Content Security Policy (CSP) - Muy estricto ===
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; worker-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https: blob:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'self';

  # === Seguridad HTTPS y protección contra ataques ===
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload

  # === Permite los editores integrados del mismo sitio; bloquea iframes externos ===
  X-Frame-Options: SAMEORIGIN

  # === Evita ataques MIME-type sniffing ===
  X-Content-Type-Options: nosniff

  # === Política de referrer más segura ===
  Referrer-Policy: strict-origin-when-cross-origin

  # === Desactiva características peligrosas del navegador ===
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=()

/*.html
  Cache-Control: no-cache, must-revalidate

/tienda/
  Cache-Control: no-cache, must-revalidate

/herramientas/
  Cache-Control: no-cache, must-revalidate

/js/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/css/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/tienda/js/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/tienda/css/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/herramientas/js/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/herramientas/css/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/img/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/vendor/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
